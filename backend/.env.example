# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=8000
NODE_ENV=development

# ============================================
# API URLs
# ============================================
# Frontend URL (for CORS)
API_FRONTEND=http://localhost:3000

# Backend URL (for generating file upload URLs)
# Lưu ý: Giá trị này phải GIỐNG với NEXT_PUBLIC_API_BACKEND trong frontend/.env
API_BACKEND=http://localhost:8000

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=beeit
DB_PORT=3306

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_ACCESS_TOKEN=your-access-token-secret-here
JWT_REFRESH_TOKEN=your-refresh-token-secret-here
JWT_ACCESS_EXPIRES_IN=30000    # tính theo giây
JWT_REFRESH_EXPIRES_IN=604800 # tính theo giây (7 ngày)
JWT_REFRESH_TOKEN_IN_DB=7    # số ngày lưu refresh token trong DB
JWT_OTP_EXPIRES_IN=300        # tính theo giây (5 phút)
OTP_MAX_ATTEMPTS=5            # số lần nhập sai OTP tối đa

# ============================================
# GOOGLE OAUTH CONFIGURATION
# ============================================
# Lưu ý: Các giá trị này phải GIỐNG với frontend/.env
# - GOOGLE_CLIENT_ID = NEXT_PUBLIC_GOOGLE_CLIENT_ID
# - GOOGLE_REDIRECT_URI = NEXT_PUBLIC_GOOGLE_REDIRECT_URI
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000

# ============================================
# SMTP/EMAIL CONFIGURATION
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============================================
# OPTIONAL CONFIGURATION
# ============================================
# REVALIDATE_SECRET=your-revalidate-secret
