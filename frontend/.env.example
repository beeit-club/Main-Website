# ============================================
# API CONFIGURATION
# ============================================
# Backend API URL
# Lưu ý: Giá trị này phải GIỐNG với API_BACKEND trong backend/.env
NEXT_PUBLIC_API_BACKEND=http://localhost:8000
NEXT_PUBLIC_API_TIMEOUT=10000

# ============================================
# GOOGLE OAUTH CONFIGURATION
# ============================================
# Lưu ý: Các giá trị này phải GIỐNG với backend/.env
# - NEXT_PUBLIC_GOOGLE_CLIENT_ID = GOOGLE_CLIENT_ID
# - NEXT_PUBLIC_GOOGLE_REDIRECT_URI = GOOGLE_REDIRECT_URI
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000

# ============================================
# SEO/URL CONFIGURATION
# ============================================
# Site URL cho SEO (có default nếu không set)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# OPTIONAL CONFIGURATION
# ============================================
# REVALIDATE_SECRET=your-revalidate-secret
